pipeline {
    agent any

    tools {
        maven 'mymaven'
        jdk 'myjava'
    }

    environment {
        JAVA_HOME = tool 'myjava'
        PATH = "${JAVA_HOME}\\bin;${env.PATH}"
    }

    parameters {
        string(name: 'THREAD_COUNT', defaultValue: '1', description: 'Parallel threads')
        string(name: 'RETRY_COUNT', defaultValue: '1', description: 'Retry failed tests')
    }

    stages {

        stage('Clean Workspace') {
            steps {
                bat 'mvn clean'
            }
        }

        stage('Run TDD Tests') {
    steps {
        bat "mvn test -DsuiteXmlFiles=testRunner/testng_tdd.xml -DthreadCount=%THREAD_COUNT% -DretryCount=%RETRY_COUNT%"
   		 }
	}

        stage('Publish Report') {
            steps {
                publishHTML([
   						 reportDir: 'reports',
    					reportFiles: 'extent-report.html',
    					reportName: 'TDD Extent Report',
    					keepAll: true,
    					alwaysLinkToLastBuild: true,
    					allowMissing: false
				])
            }
        }
    }

    post {
        always {
            echo 'Pipeline execution completed'
        }
        success {
            echo 'Build SUCCESS 🎉'
        }
        failure {
            echo 'Build FAILED ❌ Check logs'
        }
    }
}